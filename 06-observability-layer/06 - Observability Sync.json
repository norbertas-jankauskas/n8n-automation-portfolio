    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst toolUseBlock = response.content.find(c => c.type === 'tool_use');\nconst judgment = toolUseBlock.input;\n\nconst judgeInput = $('Extract Judge Input').first().json;\n\nreturn [{\n  json: {\n    traceId: judgeInput.traceId,\n    userQuery: judgeInput.userQuery,\n    toolsCalled: judgeInput.toolsCalled,\n    routing_correct: judgment.routing_correct,\n    correct_tool: judgment.correct_tool,\n    reasoning: judgment.reasoning\n  }\n}];"
      },
