      "parameters": {
        "jsCode": "const staticData = $getWorkflowStaticData('global');\nconst lastSyncedId = staticData.lastSyncedId ? parseInt(staticData.lastSyncedId) : 0;\n\nconst executions = $input.first().json.data;\n\n// Filter to only executions newer than last synced, for this workflow\nconst newExecutions = executions.filter(exec => parseInt(exec.id) > lastSyncedId);\n\nif (newExecutions.length === 0) {\n  return [];\n}\n\n// Track the highest ID seen this run, to update static data later\nconst maxId = Math.max(...newExecutions.map(e => parseInt(e.id)));\nstaticData.pendingMaxId = maxId;\n\n// Return one item per new execution, oldest first (process in order)\nreturn newExecutions\n  .sort((a, b) => parseInt(a.id) - parseInt(b.id))\n  .map(exec => ({ json: { executionId: exec.id } }));"
      },
