    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst batch = items[0].json.batch;\n\nconst trace = batch.find(e => e.type === 'trace-create');\nconst toolSpans = batch.filter(e =>\n  e.type === 'span-create' &&\n  e.body.name !== 'AI Agent' &&\n  !e.body.name.toLowerCase().includes('chat model')\n);\n\nconst toolsCalled = toolSpans.map(s => s.body.name);\n\nreturn [{\n  json: {\n    traceId: trace.body.id,\n    userQuery: trace.body.input,\n    finalAnswer: trace.body.output,\n    toolsCalled: toolsCalled\n  }\n}];"
      },
