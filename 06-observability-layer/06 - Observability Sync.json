{
  "name": "06 - Observability Sync",
  "nodes": [
    {
      "parameters": {
        "jsCode": "const execution = $input.first().json;\nconst runData = execution.data.resultData.runData;\nconst traceId = execution.id;\nconst events = [];\n\nfunction truncate(obj, maxLen = 2000) {\n  const str = typeof obj === 'string' ? obj : JSON.stringify(obj);\n  return str.length > maxLen ? str.slice(0, maxLen) + '...[truncated]' : obj;\n}\n// Trace-level event\nevents.push({\n  id: (Math.random().toString(36).slice(2) + Date.now().toString(36)),\n  type: \"trace-create\",\n  timestamp: new Date().toISOString(),\n  body: {\n    id: traceId,\n    name: execution.workflowId,\n    timestamp: execution.startedAt,\n    input: execution.customData?.input_when_chat_message_received || null,\n    output: execution.customData?.response_ai_agent || null,\n    metadata: { sessionId: execution.customData?.session_id || null }\n  }\n});\n\n// One observation per node run\nfor (const nodeName in runData) {\n  const runs = runData[nodeName];\n  runs.forEach((run, idx) => {\n    const isModel = nodeName.toLowerCase().includes(\"chat model\");\n    const startTime = new Date(run.startTime).toISOString();\n    const endTime = new Date(run.startTime + run.executionTime).toISOString();\n\n    const data = run.data || {};\n    const port = data.main || data.ai_tool || data.ai_languageModel || data.ai_memory || [];\n    const item = port?.[0]?.[0]?.json || null;\n\n    const body = {\n      id: `${traceId}-${nodeName}-${idx}`.replace(/\\s+/g, \"_\"),\n      traceId: traceId,\n      name: nodeName,\n      startTime: startTime,\n      endTime: endTime,\n      input: truncate(item),\n      output: truncate(item),\n      level: run.executionStatus === \"success\" ? \"DEFAULT\" : \"ERROR\"\n    };\n\n    if (isModel && item) {\n      const usage = item.tokenUsage || item.usage_metadata || item.usage || null;\n      if (usage) {\n        body.usage = {\n          input: usage.promptTokens || usage.input_tokens || usage.prompt_tokens || 0,\n          output: usage.completionTokens || usage.output_tokens || usage.completion_tokens || 0,\n          total: usage.totalTokens || usage.total_tokens || 0\n        };\n      }\n    }\n\n    events.push({\n      id: (Math.random().toString(36).slice(2) + Date.now().toString(36)),\n      type: isModel ? \"generation-create\" : \"span-create\",\n      timestamp: startTime,\n      body: body\n    });\n  });\n}\n\nreturn [{ json: { batch: events } }];"
      },
