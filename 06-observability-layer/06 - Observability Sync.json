        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "   application/json",
        "body": "={{ JSON.stringify({  model: \"claude-sonnet-4-6\",  max_tokens: 500,  tools: [    {      name: \"routing_judgment\",      description: \"Judge whether the AI agent chose the correct tool for the user's query\",      input_schema: {        type: \"object\",        properties: {          routing_correct: { type: \"boolean\" },          correct_tool: { type: \"string\", enum: [\"KB_Search_Tool\", \"Web_Search\", \"Direct_Answer\"] },          reasoning: { type: \"string\" }        },        required: [\"routing_correct\", \"correct_tool\", \"reasoning\"]      }    }  ],  tool_choice: { type: \"tool\", name: \"routing_judgment\" },  messages: [    {      role: \"user\",      content: \"User query: \" + $json.userQuery + \"\\n\\nTools called by agent: \" + JSON.stringify($json.toolsCalled) + \"\\n\\nAgent's final answer: \" + $json.finalAnswer + \"\\n\\nRule for judgment: time-sensitive or current-event questions (e.g. \\\"today\\\", \\\"current price\\\", \\\"is X down\\\") require Web_Search regardless of what the knowledge base returns, since the KB only covers API usage, not live/real-world state. Judge whether the tool(s) called were correct given this rule.\"    }  ]}) }}",
        "options": {}
