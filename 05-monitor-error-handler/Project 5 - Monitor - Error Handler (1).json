        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"claude-sonnet-4-6\",\n  \"max_tokens\": 500,\n  \"tools\": [\n    {\n      \"name\": \"diagnose_incident\",\n      \"description\": \"Structured diagnosis of an n8n workflow failure\",\n      \"input_schema\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"error_category\": {\n            \"type\": \"string\",\n            \"enum\": [\"rate_limit\", \"auth\", \"upstream_5xx\", \"schema_invalid\", \"timeout\", \"unknown\"]\n          },\n          \"root_cause\": {\"type\": \"string\"},\n          \"confidence\": {\"type\": \"string\", \"enum\": [\"high\", \"medium\", \"low\"]},\n          \"recommended_action\": {\"type\": \"string\"},\n          \"safe_to_auto_retry\": {\"type\": \"boolean\"}\n        },\n        \"required\": [\"error_category\", \"root_cause\", \"confidence\", \"recommended_action\", \"safe_to_auto_retry\"]\n      }\n    }\n  ],\n  \"tool_choice\": {\"type\": \"tool\", \"name\": \"diagnose_incident\"},\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"Workflow: {{ $('Error Trigger').item.json.workflow.name }}\\nFailing node: {{ $('Error Trigger').item.json.execution.lastNodeExecuted }}\\nError message: {{ $('Error Trigger').item.json.execution.error.message }}\\n\\nDiagnose this n8n execution failure. Known historical failure patterns in this environment: Gmail Trigger silently deregisters its cron on any node edit while active; Anthropic API calls fail silently if the header-auth credential Name field doesn't exactly match the expected header key; nested JSON schemas are unreliable under Haiku tool-use. Use these as context if relevant, otherwise diagnose from the error itself.\"\n    }\n  ]\n}",
        "options": {
          "response": {
            "response": {}
          }
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        432,
