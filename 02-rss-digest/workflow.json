    },
    {
      "parameters": {
        "jsCode": "const toolUse = $input.first().json.content.find(c => c.type === 'tool_use');\nlet articles = toolUse.input.articles;\nif (typeof articles === 'string') {\n  articles = JSON.parse(articles);\n}\nreturn articles.map(article => ({ json: article }));"
