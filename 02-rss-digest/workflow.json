        "jsonBody": "={{ JSON.stringify({ model: \"claude-sonnet-5\", max_tokens: 4000, tools: [{ name: \"return_digest\", description: \"Return the selected and summarized articles for the digest\", input_schema: { type: \"object\", properties: { articles: { type: \"array\", items: { type: \"object\", properties: { title: { type: \"string\" }, link: { type: \"string\" }, summary: { type: \"string\" }, source: { type: \"string\" }, guid: { type: \"string\" } }, required: [\"title\", \"link\", \"summary\", \"source\", \"guid\"] } } }, required: [\"articles\"] } }], tool_choice: { type: \"tool\", name: \"return_digest\" }, messages: [{ role: \"user\", content: \"You are curating a personal news digest in Lithuanian. Below is a JSON array of candidate articles, each with 'source' and 'guid' fields. Select the 10 most newsworthy and broadly interesting ones. Write a 2-3 sentence summary in Lithuanian for each, and preserve the original 'source' and 'guid' values unchanged.\\n\\nArticles:\\n\" + JSON.stringify($json.articles) }] }) }}",
