    {
      "parameters": {
        "jsCode": "const embedding = $json.data[0].embedding;\nconst original = $('Loop Over Items - Batch Chunks for Embedding').item.json;\n\nconst allSlugs = $('Code In JavaScript - Generate Endpoint List').all().map(i => i.json.slug);\nconst pointId = allSlugs.indexOf(original.endpoint_slug) + 1;\n\nreturn [{\n  json: {\n    id: pointId,\n    vector: embedding,\n    payload: {\n      endpoint_slug: original.endpoint_slug,\n      source_url: original.source_url,\n      content: original.content\n    }\n  }\n}];"
      },
