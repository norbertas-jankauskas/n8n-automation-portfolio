    {
      "parameters": {
        "jsCode": "const slugs = [\n  \"simple-price\", \"simple-token-price\",\n  \"coins-markets\", \"coins-id\", \"coins-contract-address\", \"coins-id-tickers\", \"coins-id-history\",\n  \"coins-id-market-chart\", \"coins-id-market-chart-range\", \"contract-address-market-chart\", \"contract-address-market-chart-range\", \"coins-id-ohlc\",\n  \"coins-categories-list\", \"coins-categories\",\n  \"exchanges-list\", \"exchanges\", \"exchanges-id\", \"exchanges-id-tickers\", \"exchanges-id-volume-chart\"\n];\n\nreturn slugs.map(slug => ({\n  json: {\n    slug: slug,\n    url: `https://docs.coingecko.com/reference/${slug}.md`\n  }\n}));"
      },
      "type": "n8n-nodes-base.code",
