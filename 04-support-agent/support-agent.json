      "credentials": { "httpMultipleHeadersAuth": { "id": "Hzw22KXSg5YxCGdK", "name": "Multiple Headers Auth account" } }
    },
    {
      "parameters": {
        "jsCode": "const originalItems = $('Code In JavaScript - Generate Endpoint List').all();\nconst scrapedItems = $input.all();\n\nconst chunks = [];\n\nfor (let i = 0; i < scrapedItems.length; i++) {\n  let content = scrapedItems[i].json.data;\n  \n  // Un-escape literal \\n sequences into real line breaks FIRST\n  content = content.replace(/\\\\n/g, '\\n');\n  \n  // Now strip the repeated boilerplate preamble (whitespace-tolerant)\n  content = content.replace(\n    /^>\\s*##\\s*Documentation Index[\\s\\S]*?before exploring further\\.\\s*/,\n    ''\n  );\n  \n  chunks.push({\n    json: {\n      endpoint_slug: originalItems[i].json.slug,\n      source_url: originalItems[i].json.url.replace('.md', ''),\n      content: content.trim()\n    }\n  });\n}\n\nreturn chunks;"
      },
